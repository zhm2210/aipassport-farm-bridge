// ============================================================
//  WiFi 凭据模板
//  用法：复制本文件为 wifi_config.h，填入你自己的 WiFi 名称和密码。
//        wifi_config.h 已被 .gitignore 排除，真实密码不会进仓库。
//
//  即使不创建 wifi_config.h 也能正常编译（固件会回退到本模板的占位符），
//  只是连不上网；工牌屏幕会提示未配置。
// ============================================================
#define WIFI_SSID   "YOUR_WIFI_SSID"
#define WIFI_PASS   "YOUR_WIFI_PASSWORD"
