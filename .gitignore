# ============================================================
#  敏感信息 —— 绝不入库
# ============================================================
# mTLS 客户端私钥 / 证书链 / JWT（Bambu 农场 API 认证用）
credentials/
*.pem
*.key
*.p12
jwt.txt

# 本机 WiFi 真实凭据（模板见 firmware/aipassport_farm/wifi_config.h.example）
wifi_config.h

# 运行时临时目录：含从进程内存提取的证书副本、日志
.tmp/
*.log

# ============================================================
#  依赖与构建产物
# ============================================================
node_modules/
tools/build/
firmware/**/build/
*.elf
*.bin

# 工具链大文件（arduino-cli 37MB / zip 18MB）：不进版本库
tools/arduino-cli.exe
tools/arduino-cli.zip

# ============================================================
#  逆向调试脚本（过程记录，本地保留，不随仓库发布）
#  注意：server/sects.ps1 必须保留 —— farmapi 运行时会调用它提取凭据
# ============================================================
server/bypass_test*.js
server/login_probe*.js
server/oracle_key.js
server/probe_*.js
server/rawpost*.js
server/test_*.js
server/serial_test.js
server/sect_presence_test.js
server/mem_scan*
server/sect_ctx.*
server/sect_decode.js
server/scan_pid.js
server/dump_req.*
server/serial_panic.js
server/.tmp_serial_dump.js
tools/_mk_autostart.js

# ============================================================
#  工作区内部目录（工作日志 / 本地环境信息，不公开）
# ============================================================
.workbuddy/

# ============================================================
#  运行时临时输出
# ============================================================
server/.tmp*
*.tmp

# ============================================================
#  含设备序列号 / 农场隐私数据
# ============================================================
农场状态报告-*.txt

# ============================================================
#  系统杂项
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
